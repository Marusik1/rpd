# Public frontend build-time configuration. GitHub Actions reads these from
# repository variables. VITE_BASE_PATH may be omitted to use /<repository>/.
VITE_BASE_PATH=/your-repository/
VITE_WORKER_URL=https://your-rpd-worker.example.workers.dev/

# Cloudflare Worker non-secret bindings (replace the placeholders).
MINI_APP_ORIGIN=https://your-user.github.io
PUBLIC_CATALOG_URL=https://your-user.github.io/your-repository/catalog.json
MINI_APP_URL=https://your-user.github.io/your-repository/
ENVIRONMENT=production

# Development only: exactly one explicitly configured localhost origin.
# It is ignored unless ENVIRONMENT=development.
DEV_MINI_APP_ORIGIN=http://localhost:5173

# Configure BOT_TOKEN and TELEGRAM_WEBHOOK_SECRET with `wrangler secret put`.
